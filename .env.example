# Секреты для EbeyParser. Скопируй в .env и заполни. Файл .env НЕ попадает в git.

# eBay API (developer.ebay.com → Application Keys → Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Разовый OAuth-токен (v^1.1#...) — живёт ~2 часа, лучше используй ключи выше
EBAY_OAUTH_TOKEN=

# Почта (Gmail: myaccount.google.com → Безопасность → Пароли приложений)
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Telegram (бот от @BotFather, chat_id — через @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: Claude как «второе мнение»
ANTHROPIC_API_KEY=
